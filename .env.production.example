# ─────────────────────────────────────────────────────────────
# Smik Party — Configuration Variables d'Environnement (Production Gratuite)
# ─────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════
# 1. SUR RENDER.COM (Variables pour le Backend API)
# ═════════════════════════════════════════════════════════════

# Chaîne de connexion PostgreSQL obtenue gratuitement sur https://neon.tech
# Important : conservez bien "?sslmode=require" à la fin de l'URL
DATABASE_URL="postgresql://neondb_owner:votre_mot_de_passe@ep-nom-instance.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Clé secrète JWT pour la signature des sessions utilisateurs (chaîne aléatoire longue)
JWT_SECRET="remplacer_par_une_cle_secrete_aleatoire_de_au_moins_32_caracteres"

# Environnement d'exécution
NODE_ENV="production"


# ═════════════════════════════════════════════════════════════
# 2. SUR VERCEL.COM (Variables pour le Frontend Web)
# ═════════════════════════════════════════════════════════════

# URL publique de votre API Render (remplacez avec votre URL Render)
VITE_API_URL="https://smik-party-api.onrender.com"

# URL publique du WebSocket Render (remplacez avec votre URL Render avec protocole wss://)
VITE_WS_URL="wss://smik-party-api.onrender.com"
