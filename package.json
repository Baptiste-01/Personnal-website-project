{
  "name": "jklm-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cd apps/api && bun --env-file=../../.env run --hot index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "tunnel": "bun run scripts/tunnel.ts",
    "online": "concurrently \"bun run dev:api\" \"bun run dev:web\" \"bun run tunnel\"",
    "build": "cd apps/web && bun run build",
    "db:generate": "cd packages/database && bun x prisma generate",
    "db:push": "cd packages/database && bun --env-file=../../.env run db:push",
    "db:seed": "cd packages/database && bun --env-file=../../.env run db:seed",
    "db:studio": "cd packages/database && bun --env-file=../../.env run db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "concurrently": "^9.2.1",
    "prisma": "^7.8.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
